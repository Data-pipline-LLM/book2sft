# Private file: copy to .env.staging, chmod 600; never commit populated values.
OPS_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
OPS_S3_USER=
OPS_S3_PASSWORD=
OPS_SERVICE_TOKEN=
OPS_HTTP_PORT=8088
# Legacy direct Chunker API full-pipeline workers; controlled Book2SFT uses stage pools.
JOB_WORKERS=2
# Bounded number of open book workflows; stage workers below own actual capacity.
BOOK_WORKFLOW_CAPACITY=1000
LEGACY_ACTIVITY_WORKERS=16
OCR_STAGE_WORKERS=16
CHUNKER_STAGE_WORKERS=16
SFT_STAGE_WORKERS=16
REVIEW_STAGE_WORKERS=4
PUBLISH_STAGE_WORKERS=4
SFT_CONCURRENCY=32
SFT_PAIR_CONCURRENCY=8
CHUNKER_LLM_CONCURRENCY=16
# Shared vLLM admission control; all SFT/Chunker LLM calls pass through this gateway.
LLM_GATEWAY_MAX_CONCURRENCY=400
LLM_GATEWAY_MAX_QUEUE=4000
LLM_GATEWAY_TIMEOUT_SEC=7200
SFT_API_THREAD_LIMIT=128
VLLM_BASE_URL=
VLLM_MODEL_NAME=
VLLM_API_KEY=
CHUNKER_LLM_URL=
CHUNKER_LLM_API_KEY=
OCR_BASE_URL=
OCR_API_KEY=
TRANSLATION_URL=
TRANSLATION_EVALUATION_URL=
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACE_URL_TEMPLATE=
TRACE_CAPTURE_CONTENT=false
OTEL_EXPORTER_OTLP_ENDPOINT=

OPS_S3_PUBLIC_ENDPOINT=
TRACE_CONTENT_LIMIT=16384

# Private server only: original Book2SFT UI, no login/user accounts.
OPS_TRUSTED_LOCAL_MODE=true
